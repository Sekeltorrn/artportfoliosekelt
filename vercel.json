{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/admin/login", "destination": "/public/admin/login.html" },
    { "source": "/admin/dashboard", "destination": "/public/admin/dashboard.html" },
    { "source": "/admin/designer", "destination": "/public/admin/designer.html" },
    { "source": "/admin/preview", "destination": "/public/admin/preview.html" },
    { "source": "/admin/settings", "destination": "/public/admin/settings.html" },
    { "source": "/commission", "destination": "/public/commission-order.html" },
    { "source": "/css/:path*", "destination": "/public/css/:path*" },
    { "source": "/js/:path*", "destination": "/public/js/:path*" },
    { "source": "/assets/:path*", "destination": "/public/assets/:path*" }
  ]
}
